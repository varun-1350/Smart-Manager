# Smart Manager Environment Configuration
# Loopback host binding for security
SMART_MANAGER_HOST=127.0.0.1
SMART_MANAGER_PORT=8765

# Local Ollama Inference Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# Agent Safety & Execution Bounds
AGENT_MAX_ITERATIONS=15
AGENT_DEFAULT_CONFIRMATION_REQUIRED=true

# Local Database
DATABASE_URL=sqlite:///data/smart_manager.db

# Debug & Logging
LOG_LEVEL=INFO
DEBUG=false
